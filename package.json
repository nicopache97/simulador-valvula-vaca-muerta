{
  "name": "simulador-balbula-control",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace apps/web",
    "test": "npm run build -w @sim/shared -w @sim/physics && npm run test --workspaces --if-present",
    "build": "npm run build -w @sim/shared -w @sim/physics && npm run build -w @sim/server -w @sim/web",
    "build:fmu": "npm run build:fmu -w @sim/fmu",
    "lint": "eslint ."
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2"
  }
}
